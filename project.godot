; Engine configuration file.
; It's best edited using the editor UI and not directly.

config_version=5

[application]

config/name="背刺拍卖会"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.4")

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
AuctionSystem="*res://scripts/systems/auction_system.gd"
IdentitySkillSystem="*res://scripts/systems/identity_skill_system.gd"
BlackMarketSystem="*res://scripts/systems/black_market_system.gd"
DebtSystem="*res://scripts/systems/debt_system.gd"
RandomEventSystem="*res://scripts/systems/random_event_system.gd"
AIController="*res://scripts/core/ai_controller.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.15, 1)
